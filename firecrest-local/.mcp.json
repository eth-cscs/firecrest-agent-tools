{
  "mcpServers": {
    "firecrest": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-e", "OAUTH_CLIENT_ID",
        "-e", "OAUTH_CLIENT_SECRET",
        "-e", "OAUTH_TOKEN_URL",
        "-e", "OAUTH_SCOPES",
        "-e", "BACKEND_API_BASE_URL",
        "${FIRECREST_MCP_IMAGE:-firecrest-mcp}",
        "uv", "run", "src/server.py", "--transport", "stdio"
      ]
    }
  }
}
