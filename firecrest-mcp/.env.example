# Copy to .env and fill in. Never commit .env.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Token endpoint of your IdP, usually ending in /token. When FirecREST and the
# IdP run in local Docker containers, use http://host.docker.internal:<port>.
OAUTH_TOKEN_URL=
OAUTH_SCOPES=firecrest-v2
BACKEND_API_BASE_URL=
# Optional: how many recent requests get_request_stats keeps (0 = all)
#REQUEST_STATS_MAX_RECORDS=1000
